        cce_directory = ""
        cce_custom_type_int = ""
        cce_custom_type_uint = ""
        cce_custom_type_real = ""
        tunable_params = "component defined"
        sp_compiler_type = "C compiler"
        sig_stim = "off"
        export_resource_list = ""
        export_dependency_list = ""
        excluded_resource_list = ""
        excluded_component_from_locking_list = ""
        export_out_file = ""
        export_lock_top_level = True
        export_encrypt_library = True
        export_encrypt_resources = True
        solver_type = "DAE"
        integration_method = "BDF"
        max_sim_step = 1e-4
        simulation_time = 1.0
        abs_tol = 1e-3
        rel_tol = 1e-3
        init_sim_step = 1e-6
        r_on_sw = 1e-3
        v_on_diode = 0.1
        data_sampling_rate = 0
        feedthrough_validation_error_level = error
    }

    component Subsystem Root {
        component "core/Ground" Ground {
        }
        [
            position = 7200, 8500
        ]

        component "core/Voltage Source" Source_a {
        }
        [
            position = 7600, 8900
        ]

        component "core/Current Measurement" Ia {
        }
        [
            position = 7600, 8300
        ]

        component "core/Voltage Measurement" Va {
        }
        [
            position = 7500, 8700
        ]

        component "core/Diode" D_ap {
            model_load_legacy = "1"
        }
        [
            position = 7600, 7900
        ]

        component "core/Diode" D_an {
            model_load_legacy = "1"
        }
        [
            position = 7600, 8100
        ]

        component "core/Voltage Source" Source_b {
        }
        [
            position = 7900, 8900
        ]

        component "core/Current Measurement" Ib {
        }
        [
            position = 7900, 8300
        ]

        component "core/Voltage Measurement" Vb {
        }
        [
            position = 7800, 8700
        ]

        component "core/Diode" D_bp {
            model_load_legacy = "1"
        }
        [
            position = 7900, 7900
        ]

        component "core/Diode" D_bn {
            model_load_legacy = "1"
        }
        [
            position = 7900, 8100
        ]

        component "core/Voltage Source" Source_c {
        }
        [
            position = 8200, 8900
        ]

        component "core/Current Measurement" Ic {
        }
        [
            position = 8200, 8300
        ]

        component "core/Voltage Measurement" Vc {
        }
        [
            position = 8100, 8700
        ]

        component "core/Diode" D_cp {
            model_load_legacy = "1"
        }
        [
            position = 8200, 7900
        ]

        component "core/Diode" D_cn {
            model_load_legacy = "1"
        }
        [
            position = 8200, 8100
        ]

        component "core/Current Measurement" Iload {
        }
        [
            position = 8900, 7800
        ]

        component "core/Resistor" Rload {
            resistance = "100.0"
        }
        [
            position = 8900, 8200
        ]

        component "core/Voltage Measurement" Vdc {
        }
        [
            position = 9200, 8100
        ]

        junction Neutral pe
        [
            position = 7400, 8500
        ]

        junction DC_plus pe
        [
            position = 8500, 7700
        ]

        junction DC_minus pe
        [
            position = 8500, 8500
        ]

        junction Phase_a pe
        [
            position = 7700, 8352
        ]

        junction Phase_b pe
        [
            position = 8000, 8352
        ]

        junction Phase_c pe
        [
            position = 8300, 8352
        ]

        connect Ground.node Neutral as Connection1
        connect Source_a.n_node Neutral as Connection2
        connect Source_a.p_node Ia.p_node as Connection3
        connect Ia.n_node Phase_a as Connection4
        connect D_ap.A Phase_a as Connection5
        connect D_ap.K DC_plus as Connection6
        connect D_an.A DC_minus as Connection7
        connect D_an.K Phase_a as Connection8
        connect Va.p_node Source_a.p_node as Connection9
        connect Va.n_node Neutral as Connection10
        connect Source_b.n_node Neutral as Connection11
        connect Source_b.p_node Ib.p_node as Connection12
        connect Ib.n_node Phase_b as Connection13
        connect D_bp.A Phase_b as Connection14
        connect D_bp.K DC_plus as Connection15
        connect D_bn.A DC_minus as Connection16
        connect D_bn.K Phase_b as Connection17
        connect Vb.p_node Source_b.p_node as Connection18
        connect Vb.n_node Neutral as Connection19
        connect Source_c.n_node Neutral as Connection20
        connect Source_c.p_node Ic.p_node as Connection21
        connect Ic.n_node Phase_c as Connection22
        connect D_cp.A Phase_c as Connection23
        connect D_cp.K DC_plus as Connection24
        connect D_cn.A DC_minus as Connection25
        connect D_cn.K Phase_c as Connection26
        connect Vc.p_node Source_c.p_node as Connection27
        connect Vc.n_node Neutral as Connection28
        connect DC_plus Iload.p_node as Connection29
        connect Iload.n_node Rload.p_node as Connection30
        connect Rload.n_node DC_minus as Connection31
        connect Vdc.p_node DC_plus as Connection32
        connect Vdc.n_node DC_minus as Connection33
    }

